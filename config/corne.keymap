#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/reset.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &kp Q  &kp W  &kp E         &kp R  &kp T        &kp Y          &kp U      &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT    &kp A  &kp S  &kp D         &kp F  &kp G        &kp H          &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C         &kp V  &kp B        &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_BRACKET
                                &kp LEFT_ALT  &mo 1  &kp SPACE    &kp BACKSPACE  &kp ENTER  &kp ESC
            >;
        };

        lower_layer {
            display-name = "LOW";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp EXCL      &kp AT        &kp HASH      &kp DLLR          &kp PRCNT       &kp CARET     &kp AMPS           &kp STAR   &kp BSLH  &kp PIPE  &trans
&trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5    &kp NUMBER_6  &kp N7             &kp N8     &kp N9    &kp N0    &trans
&trans     &kp DEL       &kp MINUS     &kp UNDER     &kp LEFT_BRACKET  &kp LPAR        &kp RPAR      &kp RIGHT_BRACKET  &kp EQUAL  &kp PLUS  &trans    &trans
                                       &kp LGUI      &trans            &kp SPACE       &kp RET       &mo 2              &kp RALT
            >;
        };

        raise_layer {
            display-name = "RAI";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&sys_reset  &kp F1        &kp F2        &kp F3        &kp F4           &kp F5        &kp F6        &kp F7         &kp F8       &kp F9        &kp F10  &sys_reset
&trans      &trans        &kp INS       &kp HOME      &kp PRINTSCREEN  &trans        &kp LEFT      &kp DOWN       &kp UP       &kp RIGHT     &kp F11  &trans
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_CLR    &kp C_VOL_DN  &kp PAGE_DOWN  &kp PAGE_UP  &kp C_VOL_UP  &kp F12  &trans
                                        &trans        &trans           &trans        &trans        &trans         &trans
            >;
        };
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
